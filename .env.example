# Never commit real secrets. Add these as environment variables in Render.
DATABASE_URL=postgresql://...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...
GOOGLE_MAPS_API_KEY=...

# Comma-separated browser origins. Native Expo requests do not rely on CORS.
CORS_ORIGINS=https://fishspotmalpe.com,https://www.fishspotmalpe.com
LOG_LEVEL=INFO
